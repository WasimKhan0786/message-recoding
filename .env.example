# Server Configuration
PORT=3000
NODE_ENV=development

# Session Secret (Change in production to a long random secret)
SESSION_SECRET=audioflow_secure_session_secret_change_in_production_key_32bytes

# Initial Admin Credentials (Bcrypt hashed at startup; plain-text never saved)
ADMIN_EMAIL=admin@audioflow.local
ADMIN_PASSWORD=AudioFlowAdmin2026!

# Filebase S3 Storage Configuration
S3_BUCKET=your_filebase_bucket_name
S3_ACCESS_KEY_ID=your_filebase_access_key
S3_SECRET_ACCESS_KEY=your_filebase_secret_key
S3_ENDPOINT=https://s3.filebase.io
S3_REGION=auto


# MongoDB Database Configuration
# Local instance or MongoDB Atlas:
MONGODB_URI=mongodb://127.0.0.1:27017/audioflow
